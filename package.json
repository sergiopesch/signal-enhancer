    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.12",
    "@workflow/vitest": "4.0.14",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "jsdom": "29.1.1",
