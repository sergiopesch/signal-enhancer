    "motion": "12.42.2",
    "next": "16.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "workflow": "4.6.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@testing-library/react": "16.3.2",
