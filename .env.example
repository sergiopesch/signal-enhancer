# Safe mode is the default. It keeps microphone audio in the browser and never
# presents the local DSP preview as AI restoration. These modes must match.
SIGNAL_MODE=demo
NEXT_PUBLIC_SIGNAL_MODE=demo

# Required for signed anonymous session cookies in live mode.
SESSION_SIGNING_SECRET=
NETWORK_HASH_SECRET=

# An existing pooled Neon Free connection is acceptable for the low-volume live
# profile. The Vercel Marketplace Neon integration is an alternative.
DATABASE_URL=

# Provision a dedicated private Vercel Blob store. Prefer the OIDC option:
# Vercel injects VERCEL_OIDC_TOKEN automatically; never copy or set it here.
BLOB_STORE_ID=
# Legacy alternative for deployments without Vercel Blob OIDC.
BLOB_READ_WRITE_TOKEN=

# Set a high-entropy value; Vercel sends it as the cron Authorization bearer.
# The checked-in Hobby schedule runs daily at 03:17 UTC.
CRON_SECRET=

# Hugging Face custom Inference Endpoint. The URL must be the HTTPS base origin
# only: https://<endpoint>.<region>.<vendor>.endpoints.huggingface.cloud
HF_ENDPOINT_URL=
HF_ENDPOINT_TOKEN=
HF_ENDPOINT_SHARED_SECRET=
# Exact lowercase Git commit served by the endpoint's /version response.
HF_ENDPOINT_BUILD_REVISION=
# Enable Vercel's system environment variables so it injects
# VERCEL_GIT_COMMIT_SHA; live validation requires it to match.

# On the Hugging Face worker, set SIGNAL_ENDPOINT_SECRET to the same value as
# HF_ENDPOINT_SHARED_SECRET. Also allow both the private object host and the
# Blob control-plane host in SIGNAL_ALLOWED_STORAGE_HOSTS.

# Cost and abuse circuit breakers.
MAX_GLOBAL_JOBS_PER_DAY=5
MAX_ACTIVE_GPU_JOBS=1

# Stable public URL used in callbacks and metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000
