# Safe mode is the default. It keeps microphone audio in the browser and never
# presents the local DSP preview as AI restoration.
SIGNAL_MODE=demo
NEXT_PUBLIC_SIGNAL_MODE=demo

# Required for signed anonymous session cookies in live mode.
SESSION_SIGNING_SECRET=
NETWORK_HASH_SECRET=

# Provision through the Vercel Marketplace Neon integration.
DATABASE_URL=

# Provision a dedicated private Vercel Blob store.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# Set a high-entropy value; Vercel sends it as the cron Authorization bearer.
CRON_SECRET=

# Hugging Face custom Inference Endpoint.
HF_ENDPOINT_URL=
HF_ENDPOINT_TOKEN=
HF_ENDPOINT_SHARED_SECRET=

# On the Hugging Face worker, set SIGNAL_ENDPOINT_SECRET to the same value as
# HF_ENDPOINT_SHARED_SECRET. Also allow both the private object host and the
# Blob control-plane host in SIGNAL_ALLOWED_STORAGE_HOSTS.

# Cost and abuse circuit breakers.
MAX_GLOBAL_JOBS_PER_DAY=100
MAX_ACTIVE_GPU_JOBS=1

# Stable public URL used in callbacks and metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000
